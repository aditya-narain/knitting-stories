# Copy to .env and fill in. Never commit real secrets.

# Database (local docker-compose defaults shown)
DATABASE_URL=jdbc:postgresql://localhost:5432/knitting_stories
DATABASE_USERNAME=knitting
DATABASE_PASSWORD=knitting

# JWT — generate a long random base64 string for production
JWT_SECRET=change-me-to-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo catalog + demo accounts on first start. Always false when deployed.
SEED_DEMO_DATA=true

# Razorpay (leave blank for local mock payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
